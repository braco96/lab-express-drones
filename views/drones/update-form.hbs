<h2>Update the drone</h2>
<h2>Update the drone</h2>

<form action="/drones/{{drone._id}}/edit" method="POST">
  <!-- Campo para modificar el nombre del dron -->
  <label>Name</label>
  <input type="text" name="name" value="{{drone.name}}" />

  <!-- Campo para modificar el número de hélices -->
  <label>Propellers</label>
  <input type="number" name="propellers" value="{{drone.propellers}}" />

  <!-- Campo para modificar la velocidad máxima -->
  <label>Max Speed</label>
  <input type="number" name="maxSpeed" value="{{drone.maxSpeed}}" />

  <button type="submit">Save changes</button> <!-- Botón que envía la actualización -->
</form>